# Production Admin Next — platform secrets live in Vercel env, not git.
# Copy contract only. Never commit real credentials / service accounts.

NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=Touri Taxi Admin Next
EXPECTED_ENVIRONMENT=production

AUTH_MODE=verified_token
SESSION_TIMEOUT_MINUTES=60
MAX_PAGE_SIZE=100

# Firebase / GCP fingerprint (Production project)
EXPECTED_PROJECT_ID=tutorial-multi-language-70gx4j
# Firebase Web SDK (public — required for browser sign-in; no private keys):
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tutorial-multi-language-70gx4j.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tutorial-multi-language-70gx4j
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tutorial-multi-language-70gx4j.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Finance reporting — Production must be production_read_only (startup fails on synthetic)
FINANCE_REPORTING_SOURCE_MODE=production_read_only

# Production read — cutover uses full Phase 4B resource set + WIF shadow-reader
PRODUCTION_READ_MODE=shadow
PRODUCTION_READ_ENABLED=true
LIVE_SHADOW_ALLOWED_RESOURCES=countries,cities,landmarks,trips,drivers,agents,customers
PRODUCTION_READ_OBSERVABILITY_SINK=structured_logger
PRODUCTION_READ_OBSERVABILITY_FILE=

# ALL write gates MUST remain false for cutover (GLOBAL kill-switch stays false)
PRODUCTION_WRITE_ENABLED=false
GLOBAL_PRODUCTION_WRITE_ENABLED=false
FINANCE_WRITE_ENABLED=false
DRIVER_WRITE_ENABLED=false
AGENT_WRITE_ENABLED=false
CUSTOMER_WRITE_ENABLED=false
CUSTOMER_AUTH_WRITE_ENABLED=false
FULL_PII_SHADOW_ENABLED=false

# Secrets (set in Vercel → Project → Settings → Environment Variables → Production):
# GOOGLE_APPLICATION_CREDENTIALS must remain UNSET (no SA private-key JSON).
# FR7 Production Firestore RO expects Vercel OIDC → GCP WIF → shadow-reader SA:
#   GCP_WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID
#   GCP_SERVICE_ACCOUNT_EMAIL=touri-admin-next-shadow-reader@tutorial-multi-language-70gx4j.iam.gserviceaccount.com
# OIDC token is request-scoped on Vercel Functions via getVercelOidcToken() (@vercel/oidc).
# Do not paste OIDC tokens into env UI; do not rely on process.env.VERCEL_OIDC_TOKEN at runtime.
# Never put private_key PEM in NEXT_PUBLIC_* or client bundles.
