# Shared example — no real secrets
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Touri Taxi Admin Next
AUTH_MODE=mock
SESSION_TIMEOUT_MINUTES=480
MAX_PAGE_SIZE=100

# Phase 4 design — read mode disabled|shadow only (no write mode)
PRODUCTION_READ_MODE=disabled
EXPECTED_PROJECT_ID=
EXPECTED_ENVIRONMENT=development

# FR7 reporting source (Production must be production_read_only)
FINANCE_REPORTING_SOURCE_MODE=synthetic

# Finance clean cutover (dry-run / archive boundary).
# YYYY-MM-DD is a BUSINESS DATE in Asia/Riyadh — NOT UTC midnight.
# 2026-10-01 Asia/Riyadh = 2026-09-30T21:00:00.000Z
FINANCE_CUTOVER_DATE=2026-10-01
FINANCE_CUTOVER_TIMEZONE=Asia/Riyadh
FINANCE_CUTOVER_APPROVED=true

# Operational write flags — armed for full Admin Next control panel.
# Finance cutover write guard still blocks pre-cutover source events.
PRODUCTION_READ_ENABLED=true
PRODUCTION_WRITE_ENABLED=true
GLOBAL_PRODUCTION_WRITE_ENABLED=true
FINANCE_WRITE_ENABLED=true
DRIVER_WRITE_ENABLED=true
AGENT_WRITE_ENABLED=true
CUSTOMER_WRITE_ENABLED=true
CUSTOMER_AUTH_WRITE_ENABLED=true
TRIP_WRITE_ENABLED=true
GEOGRAPHY_WRITE_ENABLED=true
REGION_WRITE_ENABLED=true
VEHICLE_CATALOG_WRITE_ENABLED=true
PARTNER_WRITE_ENABLED=true
FLEET_WRITE_ENABLED=true
GUIDE_WRITE_ENABLED=true
ADMIN_IDENTITY_WRITE_ENABLED=true
FULL_PII_SHADOW_ENABLED=false
SUPPORT_WRITE_ENABLED=true
NOTIFICATION_WRITE_ENABLED=true

# Show mutation chrome (buttons). API write gates remain authoritative.
NEXT_PUBLIC_CONTROLLED_WRITES_UI=true

# Phase 4A-1 — countries-only live allowlist (empty while read disabled)
LIVE_SHADOW_ALLOWED_RESOURCES=
PRODUCTION_READ_OBSERVABILITY_SINK=memory
PRODUCTION_READ_OBSERVABILITY_FILE=
