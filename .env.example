# Shared example — no real secrets
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Touri Taxi Admin Next
AUTH_MODE=mock
SESSION_TIMEOUT_MINUTES=480
MAX_PAGE_SIZE=100

# Phase 4 design — read mode disabled|shadow only (no write mode)
PRODUCTION_READ_MODE=disabled
EXPECTED_PROJECT_ID=
EXPECTED_ENVIRONMENT=development

# FR7 reporting source (Production must be production_read_only)
FINANCE_REPORTING_SOURCE_MODE=synthetic

# Production safety flags — MUST default false
PRODUCTION_READ_ENABLED=false
PRODUCTION_WRITE_ENABLED=false
GLOBAL_PRODUCTION_WRITE_ENABLED=false
FINANCE_WRITE_ENABLED=false
DRIVER_WRITE_ENABLED=false
AGENT_WRITE_ENABLED=false
CUSTOMER_WRITE_ENABLED=false
CUSTOMER_AUTH_WRITE_ENABLED=false
GEOGRAPHY_WRITE_ENABLED=false
REGION_WRITE_ENABLED=false
VEHICLE_CATALOG_WRITE_ENABLED=false
PARTNER_WRITE_ENABLED=false
FLEET_WRITE_ENABLED=false
GUIDE_WRITE_ENABLED=false
ADMIN_IDENTITY_WRITE_ENABLED=false
FULL_PII_SHADOW_ENABLED=false

# UI chrome visibility only (never authorizes writes). Leave unset/false in Production.
NEXT_PUBLIC_CONTROLLED_WRITES_UI=false

# Phase 4A-1 — countries-only live allowlist (empty while read disabled)
LIVE_SHADOW_ALLOWED_RESOURCES=
PRODUCTION_READ_OBSERVABILITY_SINK=memory
PRODUCTION_READ_OBSERVABILITY_FILE=
